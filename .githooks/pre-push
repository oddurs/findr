#!/bin/sh
# The default branch only ever advances through a merged pull request, and no
# branch leaves this machine red.
set -eu

cd "$(git rev-parse --show-toplevel)"

default_branch() {
  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  b=${b#origin/}
  [ -n "$b" ] || b=$(git config --get init.defaultBranch 2>/dev/null || true)
  [ -n "$b" ] || b=main
  printf '%s' "$b"
}

base=$(default_branch)

# git feeds us one line per ref being pushed:
#   <local ref> <local oid> <remote ref> <remote oid>
#
# It sends none at all when there is nothing to push, or when it has already
# rejected the push itself — and running the suite for a push that is not
# happening is how somebody learns to reach for --no-verify.
pushing=0
while read -r _local_ref _local_oid remote_ref remote_oid; do
  [ -n "${remote_ref:-}" ] || continue
  pushing=1
  if [ "$remote_ref" = "refs/heads/$base" ]; then
    # An all-zero remote oid means the branch does not exist there yet: this is
    # the push that creates the repository, which is not the same act as
    # advancing a default branch that people are working against. Once it
    # exists the oid is real, this branch is taken, and branch protection on the
    # server refuses as well.
    case "${remote_oid:-}" in
    *[!0]*) ;;
    *)
      printf 'pre-push: creating %s on a remote that has none — allowed once.\n' "$base"
      continue
      ;;
    esac

    printf '\npre-push: refusing to push to %s.\n\n' "$base" >&2
    printf '  %s only advances through a merged pull request:\n\n' "$base" >&2
    printf '    scripts/agent start fix/the-thing\n' >&2
    printf '    scripts/agent commit "fix: the thing"\n' >&2
    printf '    scripts/agent pr\n\n' >&2
    exit 1
  fi
done

if [ "$pushing" -eq 0 ]; then
  printf 'pre-push: nothing to push\n'
  exit 0
fi

printf 'pre-push: scripts/task check\n'
scripts/task check
